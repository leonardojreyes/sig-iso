{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synaptech.ec/schemas/libreria-norma.schema.json",
  "title": "Librería de norma (formato abierto sig-iso)",
  "description": "Describe la estructura de una norma SIN incluir su texto: solo identificadores, títulos breves, guía propia y mapeos (ADR 020).",
  "type": "object",
  "required": ["norma", "edicion", "version_libreria", "requisitos"],
  "additionalProperties": false,
  "properties": {
    "norma": { "type": "string", "minLength": 3, "description": "Ej.: ISO 9001" },
    "edicion": { "type": "string", "pattern": "^\\d{4}$" },
    "version_libreria": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "licencia_libreria": { "type": "string" },
    "requisitos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "titulo", "guia"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9]+(\\.[A-Za-z0-9]+)*$" },
          "titulo": { "type": "string", "minLength": 2, "maxLength": 80, "description": "Título breve." },
          "guia": { "type": "string", "minLength": 10, "maxLength": 600, "description": "Guía redactada por SynapTech con palabras propias (máx. 600 caracteres para evitar copiar texto de la norma)." },
          "mapeos": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["norma", "id"],
              "additionalProperties": false,
              "properties": { "norma": { "type": "string" }, "id": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
