# Plantilla de variables (se versiona). Nunca poner secretos reales en este archivo.
# Desarrollo nativo (sin Docker): copiar a .env.local, que lo genera `pnpm db:init` (no se versiona).
# Docker Compose: copiar a .env.
# Lista y significado de cada variable: docs/fase0/variables-de-entorno.md

# --- Aplicación ---
API_PORT=3001
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000

# --- Docker Compose (existentes) ---
POSTGRES_USER=sigiso
POSTGRES_PASSWORD=cambiar-en-local
POSTGRES_DB=sigiso
POSTGRES_PORT=5432
VALKEY_PORT=6379

# --- Base de datos ---
# Heredada (Docker Compose). En desarrollo nativo se usan las DATABASE_URL_* de abajo.
DATABASE_URL=postgresql://sigiso:cambiar-en-local@localhost:5432/sigiso
PGHOST=127.0.0.1
PGPORT=5432
# Una URL por rol; las genera `pnpm db:init`.
DATABASE_URL_OWNER=
DATABASE_URL_APP=
DATABASE_URL_CATALOGO=
DATABASE_URL_PLATAFORMA=
DATABASE_URL_TEST=

# --- Identidad (Keycloak) ---
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/sigiso
OIDC_CLIENT_ID=sigiso-web
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
SESSION_SEALING_KEY=
SESSION_IDLE_MINUTES=30
KEYCLOAK_HOME=.local/keycloak
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_EVENTS_CLIENT_ID=
KEYCLOAK_EVENTS_CLIENT_SECRET=

# --- Autorización (OpenFGA) ---
OPENFGA_API_URL=http://127.0.0.1:8081
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=
OPENFGA_DATASTORE_URI=

# --- Observabilidad ---
OTEL_EXPORTER=console
