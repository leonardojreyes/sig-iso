{
  "name": "sig-iso",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/nx.mjs run-many -t build",
    "test": "node scripts/nx.mjs run-many -t test --parallel=1",
    "lint": "eslint .",
    "typecheck": "node scripts/nx.mjs run-many -t typecheck",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/db-migrate.ts",
    "keycloak:install": "node scripts/keycloak-dev.mjs install",
    "keycloak:start": "node scripts/keycloak-dev.mjs start",
    "keycloak:stop": "node scripts/keycloak-dev.mjs stop",
    "keycloak:status": "node scripts/keycloak-dev.mjs status",
    "keycloak:verify": "node --env-file-if-exists=.env.local --import tsx scripts/keycloak-verificar.ts",
    "keycloak:reset": "node scripts/keycloak-dev.mjs reset",
    "keycloak:realm": "node --import tsx scripts/keycloak-realm.ts",
    "ram:report": "node scripts/ram-report.mjs",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/db-seed.ts",
    "db:seed:test": "node --env-file-if-exists=.env.local --import tsx scripts/db-seed.ts --prueba",
    "db:migrate:test": "node --env-file-if-exists=.env.local --import tsx scripts/db-migrate.ts --prueba",
    "db:init": "node --env-file-if-exists=.env.local scripts/db-init.mjs",
    "infra:up": "docker compose -f infra/compose/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/compose/docker-compose.yml down",
    "test:cov": "node scripts/nx.mjs run-many -t test:cov --parallel=1",
    "libraries:validate": "node --import tsx scripts/validate-libraries.mjs",
    "licenses:check": "node scripts/check-licenses.mjs",
    "secrets:scan": "gitleaks detect --no-banner --redact --log-opts=HEAD"
  },
  "devDependencies": {
    "@nx/devkit": "^24.0.4",
    "@nx/eslint-plugin": "^24.0.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "^8.20.0",
    "eslint": "^10.14.0",
    "nx": "^24.0.4",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.8.1"
}
